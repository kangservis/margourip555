# Salin file ini menjadi .env lalu isi nilainya. JANGAN meng-commit .env.
# Kedua nilai ini terlihat di browser (awalan PUBLIC_), jadi hanya isi nilai yang aman dipublikasikan.
# Kunci browser Firebase (sudah dibatasi ke domain situs di Google Cloud Console) dan ID project.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_PROJECT_ID=
