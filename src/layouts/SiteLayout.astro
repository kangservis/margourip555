---
import { Font } from "astro:assets";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import MobileNav from "../components/MobileNav.astro";
import { siteConfig, jalurKanonik } from "../config/site.js";
import "../styles/global.css";

const {
  title = siteConfig.name,
  description = siteConfig.description,
  currentPath = Astro.url.pathname,
  noindex = false,
  jsonLd = undefined,
  image = undefined,
} = Astro.props;

const dasar = Astro.site ?? Astro.url;
const kanonik = !noindex && Astro.site ? new URL(jalurKanonik(Astro.url.pathname), Astro.site).href : '';
const jalurGambar = image ?? siteConfig.ogImage;
const gambarOg = jalurGambar ? new URL(jalurGambar, dasar).href : '';
const jsonLdTeks = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <Font cssVariable="--font-playfair-display" preload={[{ subset: 'latin', weight: 700, style: 'normal' }]} />
    <Font cssVariable="--font-plus-jakarta-sans" preload={[{ subset: 'latin', weight: 400, style: 'normal' }]} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <!-- warna token primary -->
    <meta name="theme-color" content="#8B1D1D" />
    <meta property="og:site_name" content={siteConfig.name} />
    {kanonik && <link rel="canonical" href={kanonik} />}
    {kanonik && <meta property="og:url" content={kanonik} />}
    {gambarOg && <meta property="og:image" content={gambarOg} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    {jsonLdTeks && <script type="application/ld+json" is:inline set:html={jsonLdTeks} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class="min-h-screen bg-white font-sans text-ink antialiased">
    <a class="skip-link" href="#main-content"> Lewati ke konten </a>
    <SiteHeader currentPath={currentPath} />
    <!-- MobileNav fixed setinggi 4rem di mobile; ruang ini mencegah konten terakhir tertutup. -->
    <main id="main-content" class="pb-16 md:pb-0">
      <slot />
    </main>
    <SiteFooter />
    <MobileNav currentPath={currentPath} />
  </body>
</html>
