---
import { Font } from "astro:assets";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import MobileNav from "../components/MobileNav.astro";
import { siteConfig } from "../config/site.js";
import "../styles/global.css";

const {
  title = siteConfig.name,
  description = siteConfig.description,
  currentPath = Astro.url.pathname,
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <Font cssVariable="--font-playfair-display" preload={[{ subset: 'latin', weight: 700, style: 'normal' }]} />
    <Font cssVariable="--font-plus-jakarta-sans" preload={[{ subset: 'latin', weight: 400, style: 'normal' }]} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class="min-h-screen bg-white font-sans text-ink antialiased">
    <a class="skip-link" href="#main-content"> Lewati ke konten </a>
    <SiteHeader currentPath={currentPath} />
    <!-- MobileNav fixed setinggi 4rem di mobile; ruang ini mencegah konten terakhir tertutup. -->
    <main id="main-content" class="pb-16 md:pb-0">
      <slot />
    </main>
    <SiteFooter />
    <MobileNav currentPath={currentPath} />
  </body>
</html>
