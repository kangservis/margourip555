---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../config/site.js';
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{`Admin - ${siteConfig.name}`}</title>
		<Font cssVariable="--font-playfair-display" preload={[{ subset: 'latin', weight: 700, style: 'normal' }]} />
		<Font cssVariable="--font-plus-jakarta-sans" preload={[{ subset: 'latin', weight: 400, style: 'normal' }]} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
	</head>
	<body class="min-h-screen bg-surface font-sans text-ink antialiased">
		<p data-view="memuat" class="px-5 py-20 text-center text-base text-ink-muted">Memuat...</p>

		<section data-view="login" hidden>
			<div class="flex min-h-svh items-center justify-center px-5 py-10">
				<div class="w-full max-w-sm overflow-hidden rounded-xl border border-line bg-white">
					<div class="batik-panel batik-panel-dark batik-panel-slim px-6 py-8 text-center">
						<p class="text-xs font-semibold uppercase tracking-wide text-white">Panel admin</p>
						<h1 class="mt-2 text-2xl font-bold text-white">{siteConfig.name}</h1>
						<div class="ornament ornament-center" aria-hidden="true"></div>
					</div>
					<form data-login-form novalidate class="space-y-4 p-6">
						<p data-login-pesan role="alert" hidden class="rounded-lg border border-primary bg-surface px-4 py-3 text-base text-primary"></p>
						<div>
							<label for="login-email" class="block text-sm font-semibold text-ink">Email</label>
							<input
								id="login-email"
								name="email"
								type="email"
								autocomplete="username"
								required
								class="mt-1 min-h-12 w-full rounded-lg border border-line bg-white px-4 text-base text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
							/>
						</div>
						<div>
							<label for="login-sandi" class="block text-sm font-semibold text-ink">Kata sandi</label>
							<input
								id="login-sandi"
								name="sandi"
								type="password"
								autocomplete="current-password"
								required
								class="mt-1 min-h-12 w-full rounded-lg border border-line bg-white px-4 text-base text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
							/>
						</div>
						<button
							type="submit"
							data-login-kirim
							class="min-h-12 w-full rounded-xl bg-primary px-5 font-semibold text-white transition-colors hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:opacity-60"
						>
							Masuk
						</button>
					</form>
				</div>
			</div>
		</section>

		<section data-view="dashboard" hidden>
			<header class="border-b border-line bg-white">
				<div class="site-container flex flex-wrap items-center justify-between gap-3 py-4">
					<div class="min-w-0">
						<p class="text-xs font-semibold uppercase tracking-wide text-primary">Panel admin</p>
						<h1 class="font-serif text-xl font-bold text-ink">{siteConfig.name}</h1>
					</div>
					<div class="flex flex-wrap items-center gap-2">
						<span data-admin-email class="hidden max-w-[16rem] truncate text-sm text-ink-muted sm:inline"></span>
						<a
							href="/"
							class="inline-flex min-h-11 items-center gap-1 rounded-lg px-3 text-sm font-semibold text-primary hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
						>
							Lihat website <Icon name="arrow-right" class="size-4" />
						</a>
						<button
							type="button"
							data-keluar
							class="min-h-11 rounded-lg border border-primary px-4 text-sm font-semibold text-primary transition-colors hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
						>
							Keluar
						</button>
					</div>
				</div>
			</header>
			<main class="site-container py-6 sm:py-8">
				<div role="tablist" aria-label="Bagian admin" class="flex gap-2 overflow-x-auto pb-2">
					<button
						type="button"
						role="tab"
						id="tab-produk"
						data-tab="produk"
						aria-controls="panel-produk"
						aria-selected="false"
						tabindex="-1"
						class="min-h-11 shrink-0 rounded-full border border-line bg-white px-5 text-sm font-semibold text-ink transition-colors hover:border-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary aria-selected:border-primary aria-selected:bg-primary aria-selected:text-white"
					>Produk</button>
					<button
						type="button"
						role="tab"
						id="tab-berita"
						data-tab="berita"
						aria-controls="panel-berita"
						aria-selected="false"
						tabindex="-1"
						class="min-h-11 shrink-0 rounded-full border border-line bg-white px-5 text-sm font-semibold text-ink transition-colors hover:border-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary aria-selected:border-primary aria-selected:bg-primary aria-selected:text-white"
					>Berita</button>
					<button
						type="button"
						role="tab"
						id="tab-slider"
						data-tab="slider"
						aria-controls="panel-slider"
						aria-selected="false"
						tabindex="-1"
						class="min-h-11 shrink-0 rounded-full border border-line bg-white px-5 text-sm font-semibold text-ink transition-colors hover:border-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary aria-selected:border-primary aria-selected:bg-primary aria-selected:text-white"
					>Slider</button>
					<button
						type="button"
						role="tab"
						id="tab-struktur"
						data-tab="struktur"
						aria-controls="panel-struktur"
						aria-selected="false"
						tabindex="-1"
						class="min-h-11 shrink-0 rounded-full border border-line bg-white px-5 text-sm font-semibold text-ink transition-colors hover:border-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary aria-selected:border-primary aria-selected:bg-primary aria-selected:text-white"
					>Struktur</button>
				</div>
				<section role="tabpanel" id="panel-produk" data-panel="produk" aria-labelledby="tab-produk" hidden class="mt-4">
					<div class="rounded-xl border border-line bg-white p-5 sm:p-6">
						<div class="flex flex-col gap-3 sm:flex-row sm:items-end">
							<label class="block flex-1">
								<span class="text-sm font-semibold text-ink">Cari produk</span>
								<input type="search" data-produk-cari placeholder="Nama, kategori, atau produsen" class="mt-1 min-h-12 w-full rounded-lg border border-line bg-white px-3 text-base text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" />
							</label>
							<label class="block sm:w-56">
								<span class="text-sm font-semibold text-ink">Kategori</span>
								<select data-produk-filter-kategori class="mt-1 min-h-12 w-full rounded-lg border border-line bg-white px-3 text-base text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
									<option value="">Semua kategori</option>
								</select>
							</label>
							<button type="button" data-produk-tambah disabled class="min-h-12 w-full rounded-xl bg-primary px-5 font-semibold text-white transition-colors hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:opacity-60 sm:w-auto">Tambah produk</button>
						</div>
						<p data-produk-jumlah role="status" class="mt-4 min-h-5 text-sm text-ink-muted"></p>
						<ul data-produk-daftar class="mt-3 space-y-3"></ul>
						<p data-produk-pesan role="status" hidden class="mt-3 text-base text-ink-muted"></p>
						<button type="button" data-produk-ulang hidden class="mt-3 min-h-11 rounded-xl border border-primary px-5 font-semibold text-primary transition-colors hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">Muat ulang</button>
					</div>
				</section>
				<section role="tabpanel" id="panel-berita" data-panel="berita" aria-labelledby="tab-berita" hidden class="mt-4">
					<div class="rounded-xl border border-line bg-white p-6 text-base text-ink-muted">[ISI NANTI: pengelolaan berita dibuat di langkah berikutnya]</div>
				</section>
				<section role="tabpanel" id="panel-slider" data-panel="slider" aria-labelledby="tab-slider" hidden class="mt-4">
					<div class="rounded-xl border border-line bg-white p-5 sm:p-6">
						<h2 class="text-xl font-bold text-ink">Slider depan</h2>
						<p class="mt-1 text-base leading-7 text-ink-muted">Foto yang berganti otomatis di bagian atas Beranda (maksimal 5). Foto nomor 1 tampil lebih dulu. Geser urutan dengan tombol panah. Isi keterangan foto singkat untuk pembaca layar. Tekan Simpan perubahan agar foto dikirim.</p>
						<div data-slider-galeri class="mt-5"></div>
						<p data-slider-status role="status" class="mt-4 min-h-6 text-base text-ink-muted"></p>
						<button type="button" data-slider-simpan disabled class="mt-2 min-h-12 w-full rounded-xl bg-primary px-5 font-semibold text-white transition-colors hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:opacity-60 sm:w-auto">Simpan perubahan</button>
					</div>
				</section>
				<section role="tabpanel" id="panel-struktur" data-panel="struktur" aria-labelledby="tab-struktur" hidden class="mt-4">
					<div class="rounded-xl border border-line bg-white p-6 text-base text-ink-muted">[ISI NANTI: pengelolaan struktur dibuat di langkah berikutnya]</div>
				</section>
			</main>
		</section>

		<div data-toast-wadah aria-live="polite" class="pointer-events-none fixed inset-x-4 bottom-4 z-50 flex flex-col items-center gap-2"></div>
		<template id="tpl-toast">
			<div role="status" data-jenis="info" class="pointer-events-auto w-full max-w-sm rounded-xl border-l-4 border-gold bg-ink px-4 py-3 text-base text-white data-[jenis=galat]:border-white data-[jenis=galat]:bg-primary">
				<span data-toast-teks></span>
			</div>
		</template>
		<template id="tpl-produk-baris">
			<li data-baris class="rounded-xl border border-line bg-white p-3 sm:p-4">
				<div class="flex gap-3 sm:gap-4">
					<div class="size-16 shrink-0 overflow-hidden rounded-lg border border-line bg-surface sm:size-20">
						<img data-slot="foto" alt="" class="size-full object-contain" decoding="async" loading="lazy" />
						<div data-slot="foto-kosong" class="flex size-full items-center justify-center px-1 text-center text-xs text-ink-muted">Tanpa foto</div>
					</div>
					<div class="min-w-0 flex-1">
						<p data-slot="nama" class="break-words text-base font-semibold text-ink"></p>
						<p data-slot="meta" class="mt-0.5 text-sm text-ink-muted"></p>
						<div class="mt-2 flex flex-wrap gap-2">
							<span data-slot="badge-unggulan" class="inline-flex min-h-7 items-center rounded-full border border-gold bg-gold-soft px-3 text-xs font-semibold text-ink">Unggulan</span>
							<span data-slot="badge-preorder" class="inline-flex min-h-7 items-center rounded-full border border-line bg-white px-3 text-xs font-semibold text-ink">Pre-order</span>
							<span data-slot="badge-habis" class="inline-flex min-h-7 items-center rounded-full border border-ink bg-ink px-3 text-xs font-semibold text-white">Habis</span>
						</div>
					</div>
				</div>
				<div class="mt-3 flex gap-2 sm:justify-end">
					<button type="button" data-aksi="ubah" class="min-h-11 flex-1 rounded-lg border border-primary px-4 text-sm font-semibold text-primary transition-colors hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:flex-none">Ubah</button>
					<button type="button" data-aksi="hapus" class="min-h-11 flex-1 rounded-lg border border-line px-4 text-sm font-semibold text-ink transition-colors hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:flex-none">Hapus</button>
				</div>
			</li>
		</template>
		<template id="tpl-galeri">
			<div data-galeri>
				<label class="flex min-h-32 cursor-pointer flex-col items-center justify-center gap-1 rounded-xl border-2 border-dashed border-line bg-surface px-4 py-6 text-center text-base text-ink-muted transition-colors hover:border-primary focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-primary">
					<span class="font-semibold text-ink">Pilih foto dari galeri atau kamera</span>
					<span data-slot="batas" class="text-sm"></span>
					<input type="file" accept="image/*" data-slot="input" class="sr-only" />
				</label>
				<ul data-slot="daftar" class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3"></ul>
			</div>
		</template>
		<template id="tpl-galeri-item">
			<li data-item class="overflow-hidden rounded-xl border border-line bg-white">
				<div class="relative aspect-[4/3] border-b border-line bg-surface">
					<img data-slot="gambar" alt="" class="h-full w-full object-contain" decoding="async" />
					<span data-slot="nomor" class="absolute left-2 top-2 inline-flex size-8 items-center justify-center rounded-full bg-primary text-sm font-semibold text-white"></span>
					<div class="absolute right-2 top-2 flex flex-col items-end gap-1">
						<span data-slot="baru" class="inline-flex min-h-7 items-center rounded-full border border-gold bg-gold-soft px-3 text-xs font-semibold text-ink">Baru</span>
						<span data-slot="sampul" class="inline-flex min-h-7 items-center rounded-full border border-line bg-white px-3 text-xs font-semibold text-ink">Sampul</span>
					</div>
				</div>
				<div class="flex items-center justify-between gap-2 p-2">
					<button type="button" data-aksi="kiri" aria-label="Geser ke kiri" class="flex size-11 items-center justify-center rounded-lg border border-line text-primary transition-colors hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:opacity-40"><Icon name="arrow-left" class="size-5" /></button>
					<button type="button" data-aksi="hapus" aria-label="Hapus foto" class="flex size-11 items-center justify-center rounded-lg border border-line text-primary transition-colors hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:opacity-40"><Icon name="close" class="size-5" /></button>
					<button type="button" data-aksi="kanan" aria-label="Geser ke kanan" class="flex size-11 items-center justify-center rounded-lg border border-line text-primary transition-colors hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:opacity-40"><Icon name="arrow-right" class="size-5" /></button>
				</div>
				<label data-slot="keterangan-wadah" class="block px-2 pb-2">
					<span class="text-sm font-semibold text-ink">Keterangan foto</span>
					<input data-slot="keterangan" type="text" maxlength="120" class="mt-1 min-h-11 w-full rounded-lg border border-line bg-white px-3 text-base text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" />
				</label>
			</li>
		</template>
		<dialog
			data-konfirmasi
			aria-labelledby="konfirmasi-judul"
			class="m-auto w-[calc(100%-2.5rem)] max-w-sm rounded-xl border border-gold bg-white p-0 text-ink backdrop:bg-ink/70"
		>
			<form method="dialog" class="p-6">
				<h2 id="konfirmasi-judul" data-konfirmasi-judul class="text-xl font-bold text-ink"></h2>
				<p data-konfirmasi-pesan class="mt-2 text-base leading-7 text-ink-muted"></p>
				<div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
					<button
						value="batal"
						autofocus
						class="min-h-12 rounded-xl border border-line px-5 font-semibold text-ink transition-colors hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
					>Batal</button>
					<button
						value="ok"
						data-konfirmasi-ok
						class="min-h-12 rounded-xl bg-primary px-5 font-semibold text-white transition-colors hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
					></button>
				</div>
			</form>
		</dialog>
		<dialog id="produk-form-dialog" aria-labelledby="produk-form-judul" class="m-auto max-h-[calc(100svh-1rem)] w-[calc(100%-1rem)] max-w-2xl overflow-hidden rounded-xl border border-gold bg-white p-0 text-ink backdrop:bg-ink/70">
			<form data-produk-form novalidate class="flex max-h-[calc(100svh-1rem)] flex-col">
				<div class="flex items-center justify-between gap-3 border-b border-line px-4 py-3 sm:px-6">
					<h2 id="produk-form-judul" data-form-judul class="text-xl font-bold text-ink"></h2>
					<button type="button" data-form-tutup aria-label="Tutup formulir" class="flex size-11 items-center justify-center rounded-lg text-primary hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"><Icon name="close" class="size-6" /></button>
				</div>
				<div class="min-h-0 flex-1 space-y-5 overflow-y-auto px-4 py-5 sm:px-6">
					<label class="block">
						<span class="text-sm font-semibold text-ink">Nama produk *</span>
						<input type="text" name="nama" required maxlength="200" class="mt-1 min-h-12 w-full rounded-lg border border-line bg-white px-3 text-base text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" />
					</label>
					<label class="block">
						<span class="text-sm font-semibold text-ink">Kategori</span>
						<input type="text" name="kategori" maxlength="80" list="daftar-kategori-produk" class="mt-1 min-h-12 w-full rounded-lg border border-line bg-white px-3 text-base text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" />
						<span class="mt-1 block text-sm text-ink-muted">Ketik kategori baru atau pilih yang sudah ada.</span>
					</label>
					<label class="block">
						<span class="text-sm font-semibold text-ink">Status</span>
						<select name="status" class="mt-1 min-h-12 w-full rounded-lg border border-line bg-white px-3 text-base text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
							<option value="tersedia">Tersedia</option>
							<option value="pre-order">Pre-order</option>
							<option value="habis">Habis</option>
						</select>
					</label>
					<div class="grid gap-4 sm:grid-cols-2">
						<label class="block">
							<span class="text-sm font-semibold text-ink">Harga (Rp)</span>
							<input type="number" name="harga" inputmode="numeric" min="0" step="1" class="mt-1 min-h-12 w-full rounded-lg border border-line bg-white px-3 text-base text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" />
							<span class="mt-1 block text-sm text-ink-muted">Kosongkan bila harga ditanyakan lewat WhatsApp (tampil 'Hubungi admin'). Isi angka bulat tanpa titik atau koma.</span>
						</label>
						<label class="block">
							<span class="text-sm font-semibold text-ink">Satuan</span>
							<input type="text" name="satuan" maxlength="30" class="mt-1 min-h-12 w-full rounded-lg border border-line bg-white px-3 text-base text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" />
							<span class="mt-1 block text-sm text-ink-muted">Contoh: kg, pcs, kotak.</span>
						</label>
					</div>
					<label class="block">
						<span class="text-sm font-semibold text-ink">Minimal pesan</span>
						<input type="text" name="minimalPesan" maxlength="100" class="mt-1 min-h-12 w-full rounded-lg border border-line bg-white px-3 text-base text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" />
					</label>
					<label class="block">
						<span class="text-sm font-semibold text-ink">Produsen</span>
						<input type="text" name="produsen" maxlength="100" class="mt-1 min-h-12 w-full rounded-lg border border-line bg-white px-3 text-base text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" />
					</label>
					<label class="block">
						<span class="text-sm font-semibold text-ink">Ringkasan</span>
						<textarea name="ringkasan" rows="2" maxlength="300" class="mt-1 w-full rounded-lg border border-line bg-white px-3 py-2 text-base text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"></textarea>
						<span class="mt-1 block text-sm text-ink-muted">1-2 kalimat; tampil di popup detail.</span>
					</label>
					<label class="block">
						<span class="text-sm font-semibold text-ink">Deskripsi lengkap</span>
						<textarea name="deskripsi" rows="6" maxlength="5000" class="mt-1 w-full rounded-lg border border-line bg-white px-3 py-2 text-base text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"></textarea>
					</label>
					<label class="block">
						<span class="text-sm font-semibold text-ink">Urutan</span>
						<input type="number" name="urutan" inputmode="numeric" min="1" step="1" class="mt-1 min-h-12 w-full rounded-lg border border-line bg-white px-3 text-base text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" />
						<span class="mt-1 block text-sm text-ink-muted">Angka kecil tampil lebih dulu.</span>
					</label>
					<label class="flex min-h-11 items-center gap-3">
						<input type="checkbox" name="unggulan" class="size-5 accent-primary" />
						<span class="text-base text-ink">Jadikan produk unggulan (tampil di Beranda; hanya satu)</span>
					</label>
					<div>
						<p class="text-sm font-semibold text-ink">Foto produk</p>
						<div data-produk-galeri class="mt-2"></div>
					</div>
					<datalist id="daftar-kategori-produk"></datalist>
				</div>
