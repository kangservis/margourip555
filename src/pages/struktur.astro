---
import SiteLayout from "../layouts/SiteLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Icon from "../components/Icon.astro";
import { siteConfig } from "../config/site.js";
// Anggota struktur diatur dari /admin (tab Struktur), disimpan di Firestore (koleksi struktur), dan dimuat di browser. Nama tiap tingkat ada di src/lib/format.js (judulTingkat).
---

<SiteLayout
  title={`Struktur Organisasi - ${siteConfig.name}`}
  description={`Susunan organisasi ${siteConfig.name}.`}
>
  <PageHeader
    eyebrow="Susunan pengurus"
    title="Struktur Organisasi"
    description={`Susunan pengurus ${siteConfig.name}.`}
  />

  <section class="bg-surface">
    <div class="site-container py-16 sm:py-20">
      <div data-struktur-wadah>
        <div data-struktur-isi aria-busy="true">
          <div class="mx-auto grid max-w-5xl gap-8 md:grid-cols-2">
            <div aria-hidden="true" class="rounded-xl border border-line bg-white p-5">
              <div class="flex items-center gap-5">
                <div class="aspect-[3/4] w-28 shrink-0 rounded-lg bg-surface"></div>
                <div class="flex-1 space-y-3">
                  <div class="h-6 w-24 rounded-full bg-surface"></div>
                  <div class="h-6 w-3/4 rounded bg-surface"></div>
                </div>
              </div>
            </div>
            <div aria-hidden="true" class="rounded-xl border border-line bg-white p-5">
              <div class="flex items-center gap-5">
                <div class="aspect-[3/4] w-28 shrink-0 rounded-lg bg-surface"></div>
                <div class="flex-1 space-y-3">
                  <div class="h-6 w-24 rounded-full bg-surface"></div>
                  <div class="h-6 w-3/4 rounded bg-surface"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <p data-struktur-pesan role="status" hidden class="text-center text-base text-ink-muted"></p>
        <div class="mt-4 text-center">
          <button type="button" data-struktur-ulang hidden class="min-h-11 rounded-xl border border-primary px-5 font-semibold text-primary transition-colors hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">Muat ulang</button>
        </div>
      </div>
    </div>
  </section>

  <template id="tpl-anggota-kartu">
    <li>
      <div class="relative isolate w-full before:pointer-events-none before:absolute before:inset-0 before:-z-10 before:rotate-2 before:rounded-xl before:border before:border-line before:bg-gold-soft before:content-['']">
        <article class="relative flex items-center gap-5 rounded-xl border border-line bg-white p-5 sm:gap-6 sm:p-6 after:pointer-events-none after:absolute after:inset-2 after:rounded-lg after:border after:border-gold after:content-['']">
          <a data-slot="foto-tautan" href="#" data-foto-buka data-foto-jabatan="" data-foto-nama="" data-foto-alt="" aria-label="" class="group relative block w-28 shrink-0 overflow-hidden rounded-lg border border-line focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:w-32 lg:w-36">
            <div class="aspect-[3/4]"><img data-slot="foto-gambar" alt="" sizes="(min-width: 1024px) 144px, 112px" decoding="async" loading="lazy" class="h-full w-full object-cover object-top" /></div>
          </a>
          <div data-slot="foto-kosong" role="img" aria-label="" class="flex aspect-[3/4] w-28 shrink-0 items-center justify-center rounded-lg border border-line bg-surface p-2 text-center text-xs font-medium text-ink-muted sm:w-32 lg:w-36"></div>
          <div class="min-w-0">
            <span data-slot="jabatan" class="inline-flex min-h-7 items-center rounded-full bg-gold-soft px-3 text-xs font-semibold text-ink"></span>
            <h3 data-slot="nama" class="mt-3 break-words text-lg font-semibold leading-7 text-ink sm:text-xl"></h3>
          </div>
        </article>
      </div>
    </li>
  </template>
  <template id="tpl-anggota-kartu-besar">
    <li>
      <div class="relative isolate w-full before:pointer-events-none before:absolute before:inset-0 before:-z-10 before:rotate-2 before:rounded-xl before:border before:border-line before:bg-gold-soft before:content-['']">
        <article class="relative flex items-center gap-5 rounded-xl border border-line bg-white p-5 sm:gap-6 sm:p-6 after:pointer-events-none after:absolute after:inset-2 after:rounded-lg after:border after:border-gold after:content-[''] sm:p-8 lg:gap-8">
          <a data-slot="foto-tautan" href="#" data-foto-buka data-foto-jabatan="" data-foto-nama="" data-foto-alt="" aria-label="" class="group relative block w-32 shrink-0 overflow-hidden rounded-lg border border-line focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:w-40 lg:w-48">
            <div class="aspect-[3/4]"><img data-slot="foto-gambar" alt="" sizes="(min-width: 1024px) 192px, 128px" decoding="async" loading="eager" class="h-full w-full object-cover object-top" /></div>
          </a>
          <div data-slot="foto-kosong" role="img" aria-label="" class="flex aspect-[3/4] w-32 shrink-0 items-center justify-center rounded-lg border border-line bg-surface p-2 text-center text-xs font-medium text-ink-muted sm:w-40 lg:w-48"></div>
          <div class="min-w-0">
            <span data-slot="jabatan" class="inline-flex min-h-7 items-center rounded-full bg-gold-soft px-3 text-xs font-semibold text-ink"></span>
            <h3 data-slot="nama" class="mt-3 break-words text-xl font-semibold leading-7 text-ink sm:text-2xl"></h3>
          </div>
        </article>
      </div>
    </li>
  </template>
  <template id="tpl-tingkat">
    <section>
      <h2 data-slot="judul" class="text-center text-2xl font-bold text-ink"></h2>
      <div class="ornament ornament-center" aria-hidden="true"></div>
      <ul data-slot="daftar-tunggal" class="mt-8 mx-auto max-w-2xl"></ul>
      <ul data-slot="daftar-banyak" class="mt-8 mx-auto grid max-w-5xl gap-8 md:grid-cols-2 lg:gap-x-16"></ul>
    </section>
  </template>
  <template id="tpl-penghubung"><div class="mx-auto my-8 h-12 w-0 border-l border-gold" aria-hidden="true"></div></template>

  <dialog
    id="foto-dialog"
    aria-label="Foto pengurus"
    class="m-auto max-h-[calc(100svh-2rem)] w-[calc(100%-2.5rem)] max-w-md overflow-y-auto rounded-xl border border-gold bg-white p-0 text-ink backdrop:bg-ink/70"
  >
    <div class="p-4 sm:p-5">
      <div class="flex justify-end">
        <button
          type="button"
          data-foto-tutup
          class="flex size-11 items-center justify-center rounded-lg text-primary hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          aria-label="Tutup foto"
        >
          <Icon name="close" class="size-6" />
        </button>
      </div>
      <img
        data-foto-gambar
        alt=""
        class="mx-auto max-h-[65svh] w-auto max-w-full rounded-lg object-contain"
      />
      <div class="mt-4 text-center">
        <p
          data-foto-jabatan
          class="text-sm font-semibold uppercase tracking-wide text-primary"
        >
        </p>
        <p data-foto-nama class="mt-1 font-serif text-xl font-bold text-ink">
        </p>
      </div>
    </div>
  </dialog>

  <script>
    function initializePhotoDialog() {
      const dialog = document.querySelector<HTMLDialogElement>("#foto-dialog");
      if (!dialog) return;

      const gambar =
        dialog.querySelector<HTMLImageElement>("[data-foto-gambar]");
      const jabatan = dialog.querySelector<HTMLElement>("[data-foto-jabatan]");
      const nama = dialog.querySelector<HTMLElement>("[data-foto-nama]");
      if (!gambar || !jabatan || !nama) return;

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const pemicu = target.closest<HTMLAnchorElement>("[data-foto-buka]");
        if (pemicu) {
          event.preventDefault();
          gambar.src = pemicu.href;
          gambar.alt = pemicu.dataset.fotoAlt ?? "";
          jabatan.textContent = pemicu.dataset.fotoJabatan ?? "";
          nama.textContent = pemicu.dataset.fotoNama ?? "";
          dialog.showModal();
          document.documentElement.classList.add("overflow-hidden");
          return;
        }

        if (target.closest("[data-foto-tutup]") || target === dialog) {
          dialog.close();
        }
      });

      dialog.addEventListener("close", () => {
        document.documentElement.classList.remove("overflow-hidden");
        gambar.removeAttribute("src");
      });
    }

    initializePhotoDialog();
  </script>
  <script>
    import { tampilkanStruktur } from "../lib/tampil-struktur.js";

    const wadah = document.querySelector("[data-struktur-wadah]");
    if (wadah) tampilkanStruktur(wadah);
  </script>
</SiteLayout>
