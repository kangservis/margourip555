---
import SiteLayout from '../layouts/SiteLayout.astro';
import { siteConfig } from '../config/site.js';

const products = Array.from({ length: 3 }, (_, index) => ({
	number: String(index + 1).padStart(2, '0'),
}));

const news = Array.from({ length: 3 }, (_, index) => ({
	number: String(index + 1).padStart(2, '0'),
}));

const contactHref = siteConfig.whatsapp
	? `https://wa.me/${siteConfig.whatsapp}`
	: '/#kontak';
const contactLabel = siteConfig.whatsapp ? 'Hubungi via WhatsApp' : 'Hubungi admin';
---

<SiteLayout title={siteConfig.name} description={siteConfig.description}>
	<section id="beranda" class="scroll-mt-20 bg-surface">
		<div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:px-8 sm:py-20 lg:grid-cols-2 lg:items-center lg:gap-16 lg:py-24">
			<div>
				<p class="mb-3 text-sm font-semibold uppercase tracking-wide text-primary">
					Profil dan katalog produk unggulan
				</p>
				<h1 class="max-w-3xl text-4xl font-bold leading-tight text-ink sm:text-5xl">
					{siteConfig.name}
				</h1>
				<p class="mt-5 max-w-xl text-lg leading-8 text-ink-muted">
					Kenali produk unggulan desa dan hubungi admin untuk informasi, kerja sama, atau pemesanan.
				</p>
				<p class="mt-3 text-base leading-7 text-ink-muted">
					Tagline desa: <span class="font-medium text-ink">{siteConfig.tagline}</span>
				</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a
						class="inline-flex min-h-12 items-center justify-center rounded-xl bg-primary px-5 py-3 font-semibold text-white hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
						href="/#produk"
					>
						Lihat produk
					</a>
					<a
						class="inline-flex min-h-12 items-center justify-center rounded-xl border border-line bg-white px-5 py-3 font-semibold text-ink hover:border-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
						href={contactHref}
						target={siteConfig.whatsapp ? '_blank' : undefined}
						rel={siteConfig.whatsapp ? 'noopener noreferrer' : undefined}
					>
						{contactLabel}
					</a>
				</div>
			</div>

			<div
				class="flex aspect-[4/3] items-center justify-center rounded-2xl border border-line bg-white p-8 text-center"
				aria-label="Area foto utama desa, menunggu foto asli"
			>
				<div>
					<p class="text-sm font-semibold uppercase tracking-wide text-primary">Foto utama</p>
					<p class="mt-2 text-base text-ink-muted">[ISI NANTI: foto asli Desa Margourip]</p>
				</div>
			</div>
		</div>
	</section>

	<section id="tentang" class="scroll-mt-20">
		<div class="mx-auto grid max-w-6xl gap-5 px-5 py-16 sm:px-8 sm:py-20 md:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] md:gap-12">
			<div>
				<p class="text-sm font-semibold uppercase tracking-wide text-primary">Mengenal desa</p>
				<h2 class="mt-2 text-3xl font-bold text-ink">Tentang {siteConfig.name}</h2>
			</div>
			<div>
				<p class="text-base leading-7 text-ink-muted">
					[ISI NANTI: tulis 2–3 kalimat tentang desa berdasarkan informasi dari pemilik.]
				</p>
				<div id="struktur" class="mt-8 border-t border-line pt-5">
					<h3 class="text-lg font-semibold text-ink">Struktur organisasi</h3>
					<p class="mt-2 text-base leading-7 text-ink-muted">
						[ISI NANTI: susunan organisasi desa setelah data resmi tersedia.]
					</p>
				</div>
			</div>
		</div>
	</section>

	<section id="produk" class="scroll-mt-20 bg-surface">
		<div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
			<div class="max-w-2xl">
				<p class="text-sm font-semibold uppercase tracking-wide text-primary">Potensi desa</p>
				<h2 class="mt-2 text-3xl font-bold text-ink">Produk unggulan</h2>
				<p class="mt-3 text-base leading-7 text-ink-muted">
					Contoh susunan kartu. Nama, foto, kategori, dan informasi produk akan diisi setelah datanya tersedia.
				</p>
			</div>

			<div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
				{
					products.map((product) => (
						<article class="overflow-hidden rounded-xl border border-line bg-white">
							<div
								class="flex aspect-[4/3] items-center justify-center border-b border-line bg-surface px-4 text-center text-sm font-medium text-ink-muted"
								aria-label={`Area foto produk contoh ${product.number}`}
							>
								[ISI NANTI: foto produk]
							</div>
							<div class="p-5">
								<span class="inline-flex min-h-7 items-center rounded-full bg-gold-soft px-3 text-xs font-semibold text-ink">
									[CONTOH] Unggulan
								</span>
								<h3 class="mt-3 text-lg font-semibold text-ink">[NAMA PRODUK]</h3>
								<p class="mt-1 text-sm text-ink-muted">[KATEGORI]</p>
								<p class="mt-3 text-base leading-6 text-ink-muted">[ISI NANTI: ringkasan produk]</p>
								<p class="mt-4 border-t border-line pt-3 text-sm font-medium text-ink">
									[HARGA / HUBUNGI ADMIN]
								</p>
							</div>
						</article>
					))
				}
			</div>
			<p class="mt-6 text-sm text-ink-muted">
				Katalog lengkap akan ditambahkan setelah informasi produk tersedia.
			</p>
		</div>
	</section>

	<section id="berita" class="scroll-mt-20">
		<div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
			<div class="max-w-2xl">
				<p class="text-sm font-semibold uppercase tracking-wide text-primary">Informasi desa</p>
				<h2 class="mt-2 text-3xl font-bold text-ink">Berita terbaru</h2>
				<p class="mt-3 text-base leading-7 text-ink-muted">
					Contoh susunan berita. Judul, tanggal, foto, dan ringkasan akan diisi dari informasi resmi desa.
				</p>
			</div>

			<div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
				{
					news.map((item) => (
						<article class="overflow-hidden rounded-xl border border-line bg-white">
							<div
								class="flex aspect-[16/10] items-center justify-center border-b border-line bg-surface px-4 text-center text-sm font-medium text-ink-muted"
								aria-label={`Area foto berita contoh ${item.number}`}
							>
								[ISI NANTI: foto berita]
							</div>
							<div class="p-5">
								<p class="text-sm font-medium text-ink-muted">[TANGGAL]</p>
								<h3 class="mt-2 text-lg font-semibold leading-7 text-ink">[JUDUL BERITA]</h3>
								<p class="mt-3 text-base leading-7 text-ink-muted">
									[ISI NANTI: ringkasan berita resmi.]
								</p>
							</div>
						</article>
					))
				}
			</div>
			<p class="mt-6 text-sm text-ink-muted">Berita lainnya akan ditampilkan setelah tersedia.</p>
		</div>
	</section>

	<section aria-labelledby="contact-cta-title" class="bg-primary">
		<div class="mx-auto flex max-w-6xl flex-col gap-6 px-5 py-14 sm:px-8 sm:py-16 md:flex-row md:items-center md:justify-between">
			<div class="max-w-2xl">
				<p class="text-sm font-semibold uppercase tracking-wide text-white">Mari terhubung</p>
				<h2 id="contact-cta-title" class="mt-2 text-3xl font-bold text-white">
					Ada pertanyaan atau ingin bekerja sama?
				</h2>
				<p class="mt-3 text-base leading-7 text-white">
					Hubungi admin untuk informasi produk, kerja sama, atau peluang pemasaran.
				</p>
			</div>
			<a
				class="inline-flex min-h-12 shrink-0 items-center justify-center rounded-xl border border-white px-5 py-3 font-semibold text-white hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
				href={contactHref}
				target={siteConfig.whatsapp ? '_blank' : undefined}
				rel={siteConfig.whatsapp ? 'noopener noreferrer' : undefined}
			>
				{contactLabel}
			</a>
		</div>
	</section>

	<section id="kontak" class="scroll-mt-20 bg-surface">
		<div class="mx-auto grid max-w-6xl gap-5 px-5 py-16 sm:px-8 sm:py-20 md:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] md:gap-12">
			<div>
				<p class="text-sm font-semibold uppercase tracking-wide text-primary">Kunjungi</p>
				<h2 class="mt-2 text-3xl font-bold text-ink">Lokasi dan kontak</h2>
			</div>
			<div>
				<p class="text-base leading-7 text-ink-muted">
					Alamat kantor desa: <span class="font-medium text-ink">{siteConfig.address}</span>
				</p>
			</div>
		</div>
	</section>
</SiteLayout>
