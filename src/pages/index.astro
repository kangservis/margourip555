---
import SiteLayout from "../layouts/SiteLayout.astro";
import HeroSlider from "../components/HeroSlider.astro";
import Icon from "../components/Icon.astro";
import ProductCard from "../components/ProductCard.astro";
import NewsCard from "../components/NewsCard.astro";
import ProductDialogs from "../components/ProductDialogs.astro";
import NewsDialogs from "../components/NewsDialogs.astro";
import { getContactLink, siteConfig } from "../config/site.js";
import { getProduk } from "../config/products.js";
import { getBerita } from "../config/news.js";

const semuaProduk = await getProduk();
const produkUnggulan = semuaProduk.find((p) => p.unggulan) ?? semuaProduk[0];
const semuaBerita = await getBerita();
const beritaTerbaru = semuaBerita[0];
---

<SiteLayout title={siteConfig.name} description={siteConfig.description}>
  <!-- Hero memenuhi satu layar di semua ukuran: tinggi layar dikurangi tinggi header (65px = min-h-16 + border) dan, di mobile, dikurangi bottom nav (4rem = tinggi MobileNav). Jika tinggi header atau MobileNav berubah, perbarui angka ini. -->
  <section
    id="beranda"
    class="batik-panel text-white flex min-h-[calc(100svh-65px-4rem)] items-center md:min-h-[calc(100svh-65px)]"
  >
    <div
      class="site-container grid grid-cols-1 gap-10 py-14 sm:py-20 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-center lg:gap-x-16 lg:py-14 xl:gap-x-24 2xl:gap-x-40"
    >
      <div class="w-full max-w-lg lg:justify-self-start xl:max-w-xl">
        <p class="text-sm font-semibold uppercase tracking-wide text-white">
          Profil dan katalog produk unggulan
        </p>
        <h1
          class="mt-3 max-w-3xl text-4xl font-bold leading-tight sm:text-5xl xl:text-6xl"
        >
          {siteConfig.name}
        </h1>
        <div class="ornament" aria-hidden="true"></div>
        <p
          class="mt-5 max-w-xl text-lg leading-8 text-white lg:text-xl lg:leading-9"
        >
          {
            siteConfig.tagline.startsWith("[")
              ? "Kenali produk unggulan desa dan hubungi admin untuk informasi, kerja sama, atau pemesanan."
              : siteConfig.tagline
          }
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            class="inline-flex min-h-12 items-center justify-center rounded-xl bg-white px-5 py-3 font-semibold text-primary hover:bg-gold-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white transition-colors"
            href="/produk"
          >
            Lihat produk
          </a>
          <a
            class="inline-flex min-h-12 items-center justify-center rounded-xl border border-white px-5 py-3 font-semibold text-white hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white transition-colors"
            href={getContactLink()}
            target={siteConfig.whatsapp ? "_blank" : undefined}
            rel={siteConfig.whatsapp ? "noopener noreferrer" : undefined}
          >
            {siteConfig.whatsapp ? "Hubungi via WhatsApp" : "Hubungi admin"}
          </a>
        </div>
      </div>

      <!-- Di mobile diberi jarak atas (mt-8 sm:mt-10 lg:mt-0) agar ada ruang bernapas dari tombol di atasnya. Di desktop disejajarkan ke kanan kolom. -->
      <div
        class="mt-20 sm:mt-10 lg:mt-0 mx-auto w-full max-w-md lg:ml-auto lg:mr-0 lg:max-w-none lg:justify-self-end"
      >
        <HeroSlider />
      </div>
    </div>
  </section>

  <section id="tentang" class="bg-surface">
    <div
      class="site-container grid gap-10 py-20 sm:py-24 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-start lg:gap-x-16 lg:py-32 xl:gap-x-24 2xl:gap-x-40"
    >
      <div class="lg:justify-self-start">
        <p class="text-sm font-semibold uppercase tracking-wide text-primary">
          Mengenal desa
        </p>
        <h2 class="mt-3 text-4xl font-bold text-ink sm:text-5xl">
          Tentang {siteConfig.name}
        </h2>
        <div class="ornament" aria-hidden="true"></div>
      </div>
      <!-- Kartu bergaya kertas: lembar belakang miring + bingkai dalam emas tipis -->
      <div
        class="relative isolate w-full lg:max-w-3xl lg:justify-self-end before:pointer-events-none before:absolute before:inset-0 before:-z-10 before:rotate-2 before:rounded-xl before:border before:border-line before:bg-gold-soft before:content-['']"
      >
        <article
          class="relative rounded-xl border border-line bg-white p-6 sm:p-10 lg:p-12 after:pointer-events-none after:absolute after:inset-3 after:rounded-lg after:border after:border-gold after:content-['']"
        >
          <p
            class="text-lg leading-8 text-ink-muted first-letter:float-left first-letter:mr-3 first-letter:font-serif first-letter:text-6xl first-letter:font-bold first-letter:leading-[0.85] first-letter:text-primary"
          >
            Desa Margourip adalah sebuah desa yang terletak di Kecamatan
            Ngancar, Kabupaten Kediri, Provinsi Jawa Timur. Berada di kawasan
            subur lereng Gunung Kelud pada bagian ujung tenggara Kabupaten
            Kediri, desa ini memadukan keindahan alam vulkanik yang asri dengan
            potensi agraris yang melimpah. Secara administratif, Desa Margourip
            berbatasan langsung dengan Kabupaten Blitar di sebelah selatan dan
            terbagi ke dalam empat wilayah dusun, yaitu Dusun Margourip, Dusun
            Kaligedok, Dusun Pohgunung, dan Dusun Sumberlumbu.
          </p>
          <div
            class="mt-8 flex flex-wrap gap-x-6 gap-y-1 border-t border-line pt-5"
          >
            <a
              class="inline-flex min-h-11 items-center text-primary underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              href="/struktur"
            >
              Lihat struktur organisasi
            </a>
            <a
              class="inline-flex min-h-11 items-center text-primary underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              href="/kontak"
            >
              Lokasi dan kontak
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section aria-labelledby="featured-product-title" class="bg-white">
    <div class="site-container py-20 sm:py-24">
      <div
        class="grid gap-8 lg:grid-cols-2 lg:gap-x-16 lg:gap-y-6 xl:gap-x-24 2xl:gap-x-40"
      >
        <div
          class="lg:col-start-1 lg:row-start-1 lg:self-end lg:w-full lg:max-w-md lg:justify-self-start"
        >
          <span
            class="flex size-12 items-center justify-center rounded-full bg-gold-soft text-primary"
          >
            <Icon name="product" class="size-6" />
          </span>
          <p
            class="mt-4 text-sm font-semibold uppercase tracking-wide text-primary"
          >
            Potensi desa
          </p>
          <h2
            id="featured-product-title"
            class="mt-2 text-3xl font-bold text-ink"
          >
            Produk unggulan
          </h2>
          <div class="ornament" aria-hidden="true"></div>
          <p class="mt-5 max-w-md text-base leading-7 text-ink-muted">
            Kenali produk unggulan yang dihasilkan desa kami.
          </p>
        </div>

        <div
          class="relative isolate mx-auto w-full max-w-xl lg:mx-0 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:justify-self-end before:pointer-events-none before:absolute before:inset-0 before:-z-10 before:translate-x-3 before:translate-y-3 before:rounded-xl before:border before:border-gold before:content-['']"
        >
          {produkUnggulan && <ProductCard produk={produkUnggulan} />}
        </div>

        <div
          class="lg:col-start-1 lg:row-start-2 lg:self-start lg:w-full lg:max-w-md lg:justify-self-start"
        >
          <a
            class="inline-flex min-h-12 items-center justify-center rounded-xl bg-primary px-5 py-3 font-semibold text-white hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary transition-colors"
            href="/produk"
          >
            Lihat semua produk
          </a>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="latest-news-title" class="bg-surface">
    <div class="site-container py-20 sm:py-24">
      <div
        class="grid gap-8 lg:grid-cols-2 lg:gap-x-16 lg:gap-y-6 xl:gap-x-24 2xl:gap-x-40"
      >
        <div
          class="lg:col-start-2 lg:row-start-1 lg:self-end lg:w-full lg:max-w-md lg:justify-self-end"
        >
          <span
            class="flex size-12 items-center justify-center rounded-full bg-gold-soft text-primary"
          >
            <Icon name="news" class="size-6" />
          </span>
          <p
            class="mt-4 text-sm font-semibold uppercase tracking-wide text-primary"
          >
            Informasi desa
          </p>
          <h2 id="latest-news-title" class="mt-2 text-3xl font-bold text-ink">
            Berita terbaru
          </h2>
          <div class="ornament" aria-hidden="true"></div>
          <p class="mt-5 max-w-md text-base leading-7 text-ink-muted">
            Kabar dan informasi resmi dari desa.
          </p>
        </div>

        <div
          class="relative isolate mx-auto w-full max-w-xl lg:mx-0 lg:col-start-1 lg:row-span-2 lg:row-start-1 lg:justify-self-start before:pointer-events-none before:absolute before:inset-0 before:-z-10 before:-translate-x-3 before:translate-y-3 before:rounded-xl before:border before:border-gold before:content-['']"
        >
          {beritaTerbaru ? (
            <NewsCard berita={beritaTerbaru} />
          ) : (
            <p class="text-base text-ink-muted">[ISI NANTI: belum ada berita]</p>
          )}
        </div>

        <div
          class="lg:col-start-2 lg:row-start-2 lg:self-start lg:w-full lg:max-w-md lg:justify-self-end"
        >
          <a
            class="inline-flex min-h-12 items-center justify-center rounded-xl bg-primary px-5 py-3 font-semibold text-white hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary transition-colors"
            href="/berita"
          >
            Lihat semua berita
          </a>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="contact-cta-title" class="batik-panel">
    <div
      class="site-container flex flex-col gap-6 py-14 sm:py-16 md:flex-row md:items-center md:justify-between"
    >
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-wide text-white">
          Mari terhubung
        </p>
        <h2 id="contact-cta-title" class="mt-2 text-3xl font-bold text-white">
          Ada pertanyaan atau ingin bekerja sama?
        </h2>
        <p class="mt-3 text-base leading-7 text-white">
          Hubungi admin untuk informasi produk, kerja sama, atau peluang
          pemasaran.
        </p>
      </div>
      <a
        class="inline-flex min-h-12 shrink-0 items-center justify-center rounded-xl bg-white px-5 py-3 font-semibold text-primary hover:bg-gold-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white transition-colors"
        href={getContactLink()}
        target={siteConfig.whatsapp ? "_blank" : undefined}
        rel={siteConfig.whatsapp ? "noopener noreferrer" : undefined}
      >
        {siteConfig.whatsapp ? "Hubungi via WhatsApp" : "Hubungi admin"}
      </a>
    </div>
  </section>

  <section class="bg-white">
    <div
      class="site-container grid gap-5 py-20 sm:py-24 lg:grid-cols-2 lg:items-center lg:gap-x-16 xl:gap-x-24 2xl:gap-x-40"
    >
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-primary">
          Kunjungi
        </p>
        <h2 class="mt-2 text-3xl font-bold text-ink">Lokasi dan kontak</h2>
        <div class="ornament" aria-hidden="true"></div>
      </div>
      <div class="lg:w-full lg:max-w-md lg:justify-self-end">
        <p class="text-2xl font-bold leading-tight text-primary sm:text-3xl">
          {siteConfig.name}
        </p>
        <a
          class="mt-4 inline-flex min-h-11 items-center gap-2 text-primary underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          href={siteConfig.mapUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="map-pin" class="size-5" />
          Buka lokasi di Google Maps
        </a>
      </div>
    </div>
  </section>
  <ProductDialogs />
  <NewsDialogs />
</SiteLayout>
