---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductDetail from '../components/ProductDetail.astro';
import ProductDialogs from '../components/ProductDialogs.astro';
import { siteConfig } from '../config/site.js';
---

<SiteLayout
	title={`Produk - ${siteConfig.name}`}
	description={`Katalog produk unggulan ${siteConfig.name}.`}
>
	<PageHeader
		eyebrow="Katalog produk"
		title="Produk"
		description={`Produk unggulan ${siteConfig.name}.`}
	/>
	<section class="bg-surface">
		<div class="site-container py-16 sm:py-20">
			<div data-produk-wadah>
				<div data-produk-filter-wadah hidden>
					<div data-produk-filter role="group" aria-label="Filter kategori" class="mb-8 flex flex-wrap gap-2"></div>
				</div>
				<ul data-produk-daftar aria-busy="true" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					<li aria-hidden="true" class="overflow-hidden rounded-xl border border-line bg-white">
						<div class="aspect-[4/3] border-b border-line bg-surface"></div>
						<div class="space-y-3 p-5">
							<div class="h-4 w-1/3 rounded bg-surface"></div>
							<div class="h-6 w-3/4 rounded bg-surface"></div>
							<div class="h-12 rounded-xl bg-surface"></div>
						</div>
					</li>
					<li aria-hidden="true" class="overflow-hidden rounded-xl border border-line bg-white">
						<div class="aspect-[4/3] border-b border-line bg-surface"></div>
						<div class="space-y-3 p-5">
							<div class="h-4 w-1/3 rounded bg-surface"></div>
							<div class="h-6 w-3/4 rounded bg-surface"></div>
							<div class="h-12 rounded-xl bg-surface"></div>
						</div>
					</li>
					<li aria-hidden="true" class="overflow-hidden rounded-xl border border-line bg-white">
						<div class="aspect-[4/3] border-b border-line bg-surface"></div>
						<div class="space-y-3 p-5">
							<div class="h-4 w-1/3 rounded bg-surface"></div>
							<div class="h-6 w-3/4 rounded bg-surface"></div>
							<div class="h-12 rounded-xl bg-surface"></div>
						</div>
					</li>
				</ul>
				<p data-produk-pesan role="status" hidden class="text-center text-base text-ink-muted"></p>
				<div class="mt-4 text-center">
					<button
						type="button"
						data-produk-ulang
						hidden
						class="min-h-11 rounded-xl border border-primary px-5 font-semibold text-primary transition-colors hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
					>
						Muat ulang
					</button>
				</div>
			</div>
		</div>
	</section>
	<template id="tpl-produk-chip">
		<button
			type="button"
			data-filter-chip
			data-kategori=""
			aria-pressed="false"
			class="min-h-11 rounded-full border border-line bg-white px-4 text-sm font-semibold text-ink transition-colors hover:border-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-white"
		></button>
	</template>
	<ProductCard />
	<ProductDetail />
	<ProductDialogs />
	<script>
		import { tampilkanDaftarProduk } from '../lib/tampil-produk.js';

		const wadah = document.querySelector('[data-produk-wadah]');
		if (wadah) tampilkanDaftarProduk(wadah);
	</script>
</SiteLayout>
