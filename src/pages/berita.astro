---
import SiteLayout from '../layouts/SiteLayout.astro';
import { siteConfig } from '../config/site.js';
---

<SiteLayout
	title={`Berita Desa - ${siteConfig.name}`}
	description={`Kabar dan informasi resmi ${siteConfig.name}.`}
>
	<div class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
		<h1 class="text-3xl font-bold text-ink">Berita Desa</h1>
		<p class="mt-4 text-base leading-7 text-ink-muted">
			[ISI NANTI: daftar berita akan tampil di sini.]
		</p>
	</div>
</SiteLayout>
