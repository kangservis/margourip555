---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import NewsCard from '../components/NewsCard.astro';
import NewsDialogs from '../components/NewsDialogs.astro';
import { siteConfig } from '../config/site.js';
import { getBerita } from '../config/news.js';

const berita = await getBerita();
---

<SiteLayout
	title={`Berita Desa - ${siteConfig.name}`}
	description={`Kabar dan informasi resmi ${siteConfig.name}.`}
>
	<PageHeader
		eyebrow="Kabar desa"
		title="Berita Desa"
		description={`Kabar dan informasi resmi ${siteConfig.name}.`}
	/>
	<section class="bg-surface">
		<div class="site-container py-16 sm:py-20">
			{berita.length === 0 ? (
				<p class="text-center text-base text-ink-muted">[ISI NANTI: belum ada berita]</p>
			) : (
				<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{berita.map((b) => (
						<li>
							<NewsCard berita={b} />
						</li>
					))}
				</ul>
			)}
		</div>
	</section>
	<NewsDialogs />
</SiteLayout>
