---
import { navigationItems, siteConfig } from '../config/site.js';

const { currentPath = '/' } = Astro.props;
---

<header class="border-b border-line bg-white">
	<div class="mx-auto flex min-h-16 max-w-6xl items-center justify-between gap-6 px-5 sm:px-8">
		<a
			class="rounded-sm text-lg font-bold text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
			href="/#beranda"
		>
			{siteConfig.name}
		</a>
		<nav class="hidden items-center gap-1 md:flex" aria-label="Navigasi utama">
			{
				navigationItems.map((item) => (
					<a
						class:list={[
							'inline-flex min-h-11 items-center rounded-lg px-3 text-sm font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary',
							currentPath === '/' && item.label === 'Beranda'
								? 'bg-surface text-primary'
								: 'text-ink hover:bg-surface hover:text-primary',
						]}
						href={item.href}
						aria-current={currentPath === '/' && item.label === 'Beranda' ? 'page' : undefined}
					>
						{item.label}
					</a>
				))
			}
		</nav>
	</div>
</header>
