---
import { siteConfig } from '../config/site.js';
// Tahun diambil saat build
const year = new Date().getFullYear();
---

<!-- Footer hanya tampil di desktop. Di mobile navigasi memakai MobileNav. -->
<footer class="hidden md:block">
	<div class="batik-panel batik-panel-dark batik-panel-slim">
		<div class="site-container py-6 text-center">
			<p class="text-sm text-white">© {year} {siteConfig.name}. Hak Cipta Dilindungi Undang-Undang.</p>
			{siteConfig.credit && <p class="mt-1 text-sm text-gold-soft">{siteConfig.credit}</p>}
		</div>
	</div>
</footer>
