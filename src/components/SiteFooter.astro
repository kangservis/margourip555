---
import { getWhatsAppLink, navigationItems, siteConfig } from '../config/site.js';
import Icon from './Icon.astro';
---

<footer class="border-t border-gold bg-primary-dark text-white">
	<div class="mx-auto max-w-6xl px-5 py-8 pb-24 sm:px-8 md:pb-8">
		<p class="font-serif font-semibold">{siteConfig.name}</p>
		<p class="mt-2 text-base">Alamat: {siteConfig.address}</p>
		<nav class="mt-5" aria-label="Tautan cepat">
			<ul class="flex flex-wrap gap-x-4 gap-y-1">
				{
					navigationItems.map((item) => (
						<li>
							<a
								class="inline-flex min-h-11 items-center rounded-sm underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
								href={item.href}
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		{
			siteConfig.whatsapp && (
				<a
					class="mt-3 inline-flex min-h-11 items-center gap-2 rounded-sm font-medium underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
					href={getWhatsAppLink()}
					target="_blank"
					rel="noopener noreferrer"
				>
					<Icon name="whatsapp" class="size-5" />
					Hubungi via WhatsApp
				</a>
			)
		}
	</div>
</footer>
