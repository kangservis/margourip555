---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { siteConfig } from '../config/site.js';

// Jeda antar foto (milidetik). Ubah angka ini untuk mengatur kecepatan.
const INTERVAL_MS = 5000;

// Jumlah foto maksimal di slider. Foto ke-6 dan seterusnya (menurut urutan nama file) diabaikan.
const MAX_SLIDES = 5;

// Tambahkan maksimal 5 foto ke src/assets/slider-depan/ dengan nama berawalan angka dan deskriptif (contoh: 01-sawah-desa.jpg).
// Urutan mengikuti nama file; alt otomatis dibuat dari nama file.
// Semua foto tampil utuh (fit to card / object-contain) di dalam kartu berasio 3:2 dengan latar panel batik jika rasio foto berbeda.
// Saran ukuran foto sumber maksimal sekitar 2000 px lebar.
const modules = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/slider-depan/*.{jpg,jpeg,png,webp,avif}',
	{ eager: true },
);

if (Object.keys(modules).length > MAX_SLIDES) {
	console.warn(`Folder src/assets/slider-depan berisi ${Object.keys(modules).length} foto; hanya ${MAX_SLIDES} foto pertama (menurut urutan nama file) yang dipakai.`);
}

const slides = Object.entries(modules)
	.sort(([pathA], [pathB]) => pathA.localeCompare(pathB))
	.slice(0, MAX_SLIDES)
	.map(([path, module]) => {
		const fileName = path.split('/').pop()?.replace(/\.[^.]+$/, '') ?? '';
		const alt = fileName.replace(/^\d+[-_ ]*/, '').replace(/[-_]/g, ' ').trim();

		return {
			src: module.default,
			alt: alt || `Foto ${siteConfig.name}`,
		};
	});
---

<div data-hero-slider data-interval={INTERVAL_MS}>
	{
		slides.length > 0 ? (
			<>
				<div
					class="batik-panel batik-panel-dark batik-panel-card relative aspect-[3/2] touch-pan-y"
					role="region"
					aria-roledescription="carousel"
					aria-label={`Foto ${siteConfig.name}`}
				>
					{
						slides.map((slide, index) => (
							<div
								data-slide
								class:list={[
									'absolute inset-0 transition-opacity duration-500 motion-reduce:transition-none',
									index === 0 ? 'opacity-100' : 'opacity-0',
								]}
								role="group"
								aria-roledescription="slide"
								aria-label={`${index + 1} dari ${slides.length}`}
								aria-hidden={index === 0 ? 'false' : 'true'}
							>
								<Image
									src={slide.src}
									alt={slide.alt}
									format="webp"
									quality={75}
									widths={[480, 720, 1080]}
									sizes="(min-width: 1024px) 900px, 100vw"
									class="h-full w-full object-contain object-center"
									decoding="async"
									loading={index === 0 ? 'eager' : 'lazy'}
									fetchpriority={index === 0 ? 'high' : 'low'}
								/>
							</div>
						))
					}
				</div>
				<!-- Lebar tombol titik dikecilkan saat 5 foto agar titik lebih rapat (28px, di atas minimum aksesibilitas 24px). -->
				{
					slides.length === 1 ? (
						<div class="mt-3 flex min-h-11 items-center justify-center" aria-hidden="true">
							<span class="size-2.5 rounded-full bg-gold"></span>
						</div>
					) : slides.length >= 2 ? (
						<div data-dots class="invisible mt-3 flex min-h-11 items-center justify-center">
							{slides.map((_, index) => (
								<button
									type="button"
									data-dot
									class:list={[
										'flex h-11 items-center justify-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white',
										slides.length >= 5 ? 'w-7' : 'w-11',
									]}
									aria-label={`Tampilkan foto ${index + 1}`}
									aria-current={index === 0 ? 'true' : undefined}
								>
									<span
										class:list={[
											'size-2.5 rounded-full',
											index === 0 ? 'bg-gold' : 'bg-white/50',
										]}
									/>
								</button>
							))}
						</div>
					) : null
				}
			</>
		) : (
			<div
				class="batik-panel batik-panel-dark batik-panel-card flex aspect-[3/2] items-center justify-center p-8 text-center"
				role="img"
				aria-label="Placeholder foto asli Desa Margourip"
			>
				<p class="text-base font-medium text-white">[ISI NANTI: foto asli Desa Margourip]</p>
			</div>
		)
	}
</div>

<script>
	function initializeHeroSlider() {
		const root = document.querySelector<HTMLElement>('[data-hero-slider]');
		if (!root) return;

		const slides = root.querySelectorAll<HTMLElement>('[data-slide]');
		const dots = root.querySelectorAll<HTMLButtonElement>('[data-dot]');
		if (slides.length < 2) return;

		const dotsContainer = root.querySelector<HTMLElement>('[data-dots]');
		const frame = root.querySelector<HTMLElement>('[aria-roledescription="carousel"]');
		if (!dotsContainer || !frame) return;

		dotsContainer.classList.remove('invisible');

		const configuredInterval = Number(root.dataset.interval);
		const interval = Number.isFinite(configuredInterval) && configuredInterval > 0
			? configuredInterval
			: 5000;
		let activeIndex = 0;
		let timer = 0;
		let touchStartX: number | null = null;
		let touchStartY: number | null = null;

		function stop() {
			clearInterval(timer);
			timer = 0;
		}

		function show(index: number) {
			activeIndex = ((index % slides.length) + slides.length) % slides.length;

			slides.forEach((slide, slideIndex) => {
				const isActive = slideIndex === activeIndex;
				slide.classList.toggle('opacity-100', isActive);
				slide.classList.toggle('opacity-0', !isActive);
				slide.setAttribute('aria-hidden', String(!isActive));
			});

			dots.forEach((dot, dotIndex) => {
				const isActive = dotIndex === activeIndex;
				const indicator = dot.querySelector('span');

				if (indicator) {
					indicator.classList.toggle('bg-gold', isActive);
					indicator.classList.toggle('bg-white/50', !isActive);
				}

				if (isActive) {
					dot.setAttribute('aria-current', 'true');
				} else {
					dot.removeAttribute('aria-current');
				}
			});
		}

		// Autoplay sengaja tidak dijeda oleh hover/fokus/kurangi-gerakan. Untuk pengguna kurangi-gerakan, perpindahan foto instan (tanpa crossfade) lewat motion-reduce di markup.
		function start() {
			stop();
			// Jeda hanya saat tab browser tidak aktif
			if (document.visibilityState === 'hidden') return;
			timer = setInterval(() => show(activeIndex + 1), interval);
		}

		document.addEventListener('visibilitychange', () => {
			if (document.visibilityState === 'hidden') {
				stop();
			} else {
				start();
			}
		});

		dots.forEach((dot, index) => {
			dot.addEventListener('click', () => {
				show(index);
				start();
			});
		});

		frame.addEventListener(
			'touchstart',
			(event) => {
				if (event.touches.length !== 1) {
					touchStartX = null;
					touchStartY = null;
					return;
				}

				touchStartX = event.touches[0].clientX;
				touchStartY = event.touches[0].clientY;
			},
			{ passive: true },
		);
		frame.addEventListener(
			'touchend',
			(event) => {
				const touch = event.changedTouches[0];
				if (!touch || touchStartX === null || touchStartY === null) return;

				const deltaX = touch.clientX - touchStartX;
				const deltaY = touch.clientY - touchStartY;
				touchStartX = null;
				touchStartY = null;

				if (Math.abs(deltaX) > 40 && Math.abs(deltaX) > Math.abs(deltaY)) {
					show(activeIndex + (deltaX < 0 ? 1 : -1));
					start();
				}
			},
			{ passive: true },
		);

		frame.addEventListener('touchcancel', () => {
			touchStartX = null;
			touchStartY = null;
		});

		start();
	}

	initializeHeroSlider();
</script>
