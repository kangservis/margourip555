---
interface Props {
	title: string;
	eyebrow?: string;
	description?: string;
}

const { title, eyebrow, description } = Astro.props;
---

<!-- Band judul ramping untuk halaman dalam. Dipakai di Produk, Berita, Struktur, dan Kontak. -->
<section class="batik-panel">
	<div class="site-container flex flex-col items-center py-8 text-center sm:py-10">
		{eyebrow && <p class="text-xs font-semibold uppercase tracking-wider text-white sm:text-sm">{eyebrow}</p>}
		<h1 class={eyebrow ? 'mt-1.5 text-2xl font-bold text-white sm:mt-2 sm:text-3xl lg:text-4xl' : 'text-2xl font-bold text-white sm:text-3xl lg:text-4xl'}>{title}</h1>
		<div class="ornament ornament-center !mt-2 sm:!mt-2.5" aria-hidden="true"></div>
		{description && <p class="mt-2.5 max-w-xl text-sm leading-6 text-white sm:mt-3 sm:text-base sm:leading-7">{description}</p>}
	</div>
</section>
