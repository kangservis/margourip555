---
import { isActive, navigationItems } from '../config/site.js';
import Icon from './Icon.astro';

const { currentPath = '/' } = Astro.props;
---

<nav
	class="fixed inset-x-0 bottom-0 z-30 grid grid-cols-5 border-t border-line bg-white pb-[env(safe-area-inset-bottom)] md:hidden"
	aria-label="Navigasi bawah"
>
	{
		navigationItems.map((item) => (
			<a
				class:list={[
					'flex min-h-16 flex-col items-center justify-center gap-1 px-1 text-center text-xs font-medium focus-visible:z-10 focus-visible:outline-2 focus-visible:outline-primary',
					isActive(currentPath, item.href)
						? 'bg-surface text-primary'
						: 'text-ink hover:bg-surface hover:text-primary',
				]}
				href={item.href}
				aria-current={isActive(currentPath, item.href) ? 'page' : undefined}
			>
				<Icon name={item.icon} class="size-6" />
				<span>{item.label}</span>
			</a>
		))
	}
</nav>
