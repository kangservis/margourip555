---
// Template isi popup detail berita. Diisi oleh src/lib/tampil-berita.js.
---

<template id="tpl-berita-detail">
	<article class="mx-auto max-w-2xl px-4 pb-8 sm:px-6 sm:pb-12">
		<time data-slot="tanggal" class="text-sm font-semibold uppercase tracking-wide text-primary"></time>
		<h2 id="berita-dialog-judul" data-slot="judul" class="mt-2 break-words text-3xl font-bold leading-tight text-ink sm:text-4xl"></h2>
		<div class="ornament" aria-hidden="true"></div>
		<button
			type="button"
			data-slot="lightbox"
			data-berita-lightbox-buka
			data-besar=""
			data-alt=""
			data-nama=""
			aria-label="Perbesar foto"
			class="relative mt-6 block w-full overflow-hidden rounded-lg border border-line bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
		>
			<img data-slot="gambar" alt="" class="mx-auto max-h-[50svh] w-auto max-w-full object-contain" decoding="async" />
		</button>
		<div data-slot="isi" class="mt-6 space-y-5 text-lg leading-8 text-ink"></div>
	</article>
</template>
