---
import Icon from './Icon.astro';

const { berita } = Astro.props;
const foto = berita.foto;
---

<article class="mx-auto max-w-2xl px-4 pb-8 sm:px-6 sm:pb-12">
	<time datetime={berita.tanggalISO} class="text-sm font-semibold uppercase tracking-wide text-primary">{berita.tanggalTampil}</time>
	<h2 id="berita-dialog-judul" class="mt-2 break-words text-3xl font-bold leading-tight text-ink sm:text-4xl">{berita.judul}</h2>
	<div class="ornament" aria-hidden="true"></div>
	{foto && (
		<button
			type="button"
			data-berita-lightbox-buka
			data-besar={foto.besar}
			data-alt={foto.alt}
			data-nama={berita.judul}
			aria-label="Perbesar foto"
			class="relative mt-6 block w-full overflow-hidden rounded-lg border border-line bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
		>
			<img src={foto.besar} alt={foto.alt} class="mx-auto max-h-[50svh] w-auto max-w-full object-contain" decoding="async" />
			<span class="absolute bottom-2 right-2 flex size-8 items-center justify-center rounded-full bg-white text-primary">
				<Icon name="zoom-in" class="size-4" />
			</span>
		</button>
	)}
	{berita.paragraf.length > 0 && (
		<div class="mt-6 space-y-5 text-lg leading-8 text-ink">
			{berita.paragraf.map((p) => (
				<p>{p}</p>
			))}
		</div>
	)}
</article>
