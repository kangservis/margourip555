---
// Template kartu produk. Diisi oleh src/lib/tampil-produk.js dari data Firestore. Pakai sekali per halaman bersama ProductDetail.
import Icon from './Icon.astro';
---

<template id="tpl-produk-kartu">
	<article
		class="relative flex h-full flex-col overflow-hidden rounded-xl border border-line bg-white transition-colors hover:border-primary"
		data-produk-kartu
	>
		<div class="relative aspect-[4/3] border-b border-line bg-surface">
			<img
				data-slot="foto"
				alt=""
				width="640"
				height="480"
				sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 100vw"
				decoding="async"
				loading="lazy"
				class="h-full w-full object-contain object-center"
			/>
			<div
				data-slot="foto-kosong"
				role="img"
				aria-label=""
				class="flex size-full items-center justify-center px-4 text-center text-base font-medium text-ink-muted"
			>
				[ISI NANTI: foto produk]
			</div>
			<div class="absolute left-3 top-3 flex flex-wrap gap-2">
				<span
					data-slot="badge-unggulan"
					class="inline-flex min-h-7 items-center rounded-full border border-gold bg-gold-soft px-3 text-xs font-semibold text-ink"
				>
					Unggulan
				</span>
				<span
					data-slot="badge-preorder"
					class="inline-flex min-h-7 items-center rounded-full border border-line bg-white px-3 text-xs font-semibold text-ink"
				>
					Pre-order
				</span>
				<span
					data-slot="badge-habis"
					class="inline-flex min-h-7 items-center rounded-full border border-ink bg-ink px-3 text-xs font-semibold text-white"
				>
					Habis
				</span>
			</div>
		</div>
		<div class="flex flex-1 flex-col p-5">
			<p data-slot="kategori" class="text-sm font-semibold uppercase tracking-wide text-primary"></p>
			<h3 class="mt-2 text-lg font-semibold leading-7 text-ink">
				<button
					type="button"
					data-produk-buka
					data-slot="nama"
					aria-haspopup="dialog"
					class="cursor-pointer text-left after:absolute after:inset-0 after:rounded-xl after:content-[''] focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-2 focus-visible:after:outline-primary"
				></button>
			</h3>
			<p class="mt-3 text-xl font-bold text-primary" data-slot="harga">
				<span data-slot="harga-angka"></span>
				<span data-slot="harga-satuan" class="ml-1 text-sm font-medium text-ink-muted"></span>
			</p>
			<p data-slot="harga-kosong" class="mt-3 text-base font-medium text-ink-muted">Hubungi admin</p>
			<div class="mt-auto pt-5">
				<a
					data-slot="wa"
					href="#"
					class="relative z-10 inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-xl bg-primary px-5 py-3 font-semibold text-white transition-colors hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
				>
					<Icon name="whatsapp" class="size-5" />
					<span data-slot="wa-label"></span>
				</a>
			</div>
		</div>
		<template data-produk-detail></template>
	</article>
</template>
