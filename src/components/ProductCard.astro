---
// Kartu produk. Dipakai di Beranda (produk unggulan) dan halaman Produk agar tampil seragam. Ringkasan hanya tampil di popup detail.
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import ProductDetail from "./ProductDetail.astro";
import { getContactLink, siteConfig } from "../config/site.js";

const { produk } = Astro.props;
const foto = produk.foto[0];
const adaWa = Boolean(siteConfig.whatsapp);
---

<article
  class="relative flex h-full flex-col overflow-hidden rounded-xl border border-line bg-white transition-colors hover:border-primary"
  data-produk-kartu
>
  <div class="relative aspect-[4/3] border-b border-line bg-surface">
    {
      foto ? (
        <Image
          src={foto.src}
          alt={foto.alt}
          format="webp"
          quality={75}
          widths={[320, 480, 640]}
          sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 100vw"
          class="h-full w-full object-cover"
          decoding="async"
          loading="lazy"
        />
      ) : (
        <div
          role="img"
          aria-label={`Placeholder foto ${produk.nama}`}
          class="flex size-full items-center justify-center px-4 text-center text-base font-medium text-ink-muted"
        >
          [ISI NANTI: foto produk]
        </div>
      )
    }
    <div class="absolute left-3 top-3 flex flex-wrap gap-2">
      {
        produk.unggulan && (
          <span class="inline-flex min-h-7 items-center rounded-full border border-gold bg-gold-soft px-3 text-xs font-semibold text-ink">
            Unggulan
          </span>
        )
      }
      {
        produk.status === "pre-order" && (
          <span class="inline-flex min-h-7 items-center rounded-full border border-line bg-white px-3 text-xs font-semibold text-ink">
            {produk.statusInfo.label}
          </span>
        )
      }
      {
        produk.status === "habis" && (
          <span class="inline-flex min-h-7 items-center rounded-full border border-ink bg-ink px-3 text-xs font-semibold text-white">
            {produk.statusInfo.label}
          </span>
        )
      }
    </div>
  </div>
  <div class="flex flex-1 flex-col p-5">
    <p class="text-sm font-semibold uppercase tracking-wide text-primary">
      {produk.kategori}
    </p>
    <h3 class="mt-2 text-lg font-semibold leading-7 text-ink">
      <button
        type="button"
        data-produk-buka
        aria-haspopup="dialog"
        class="cursor-pointer text-left after:absolute after:inset-0 after:rounded-xl after:content-[''] focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-2 focus-visible:after:outline-primary"
      >
        {produk.nama}
      </button>
    </h3>
    {
      produk.hargaTampil ? (
        <p class="mt-3 text-xl font-bold text-primary">
          {produk.hargaTampil}
          {produk.satuan && (
            <span class="ml-1 text-sm font-medium text-ink-muted">
              / {produk.satuan}
            </span>
          )}
        </p>
      ) : (
        <p class="mt-3 text-base font-medium text-ink-muted">Hubungi admin</p>
      )
    }
    <div class="mt-auto pt-5">
      <a
        href={getContactLink(produk.pesanWa)}
        target={adaWa ? "_blank" : undefined}
        rel={adaWa ? "noopener noreferrer" : undefined}
        class="relative z-10 inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-xl bg-primary px-5 py-3 font-semibold text-white transition-colors hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        <Icon name="whatsapp" class="size-5" />
        {produk.statusInfo.tombol}
      </a>
    </div>
  </div>
  <template data-produk-detail><ProductDetail produk={produk} /></template>
</article>
