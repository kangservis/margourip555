---
// Template isi popup detail produk. Diisi oleh src/lib/tampil-produk.js.
import Icon from './Icon.astro';
---

<template id="tpl-produk-detail">
	<div data-detail-root class="grid gap-6 p-4 sm:p-6 md:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] md:gap-8">
		<div>
			<div
				data-slot="galeri"
				data-galeri-root
				data-fotos="[]"
				data-index="0"
				class="group relative w-full overflow-hidden rounded-lg border border-line bg-surface"
			>
				<button
					type="button"
					data-lightbox-buka
					data-besar=""
					data-alt=""
					data-nama=""
					aria-label="Perbesar foto"
					class="block w-full cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
				>
					<img
						data-detail-gambar
						data-slot="gambar"
						alt=""
						class="aspect-[4/3] w-full object-contain object-center"
						decoding="async"
					/>
				</button>
				<button
					type="button"
					data-slot="panah"
					data-galeri-prev
					aria-label="Foto sebelumnya"
					class="absolute left-2.5 top-1/2 z-10 hidden size-9 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-primary shadow-sm opacity-0 transition-opacity duration-200 hover:bg-white focus-visible:opacity-100 focus-visible:outline-2 focus-visible:outline-primary group-hover:opacity-100 sm:flex"
				>
					<Icon name="arrow-left" class="size-5" />
				</button>
				<button
					type="button"
					data-slot="panah"
					data-galeri-next
					aria-label="Foto berikutnya"
					class="absolute right-2.5 top-1/2 z-10 hidden size-9 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-primary shadow-sm opacity-0 transition-opacity duration-200 hover:bg-white focus-visible:opacity-100 focus-visible:outline-2 focus-visible:outline-primary group-hover:opacity-100 sm:flex"
				>
					<Icon name="arrow-right" class="size-5" />
				</button>
			</div>
			<div
				data-slot="foto-kosong"
				role="img"
				aria-label=""
				class="flex aspect-[4/3] items-center justify-center rounded-lg border border-line bg-surface px-4 text-center text-base font-medium text-ink-muted"
			>
				[ISI NANTI: foto produk]
			</div>
		</div>
		<div class="min-w-0">
			<p data-slot="kategori" class="text-sm font-semibold uppercase tracking-wide text-primary"></p>
			<h2 data-slot="nama" id="produk-dialog-judul" class="mt-2 break-words text-2xl font-bold text-ink sm:text-3xl"></h2>
			<div class="ornament" aria-hidden="true"></div>
			<div class="mt-4 flex flex-wrap gap-2">
				<span
					data-slot="badge-unggulan"
					class="inline-flex min-h-7 items-center rounded-full border border-gold bg-gold-soft px-3 text-xs font-semibold text-ink"
				>
					Unggulan
				</span>
				<span
					data-slot="badge-tersedia"
					class="inline-flex min-h-7 items-center rounded-full border border-line bg-surface px-3 text-xs font-semibold text-ink"
				>
					Tersedia
				</span>
				<span
					data-slot="badge-preorder"
					class="inline-flex min-h-7 items-center rounded-full border border-line bg-white px-3 text-xs font-semibold text-ink"
				>
					Pre-order
				</span>
				<span
					data-slot="badge-habis"
					class="inline-flex min-h-7 items-center rounded-full border border-ink bg-ink px-3 text-xs font-semibold text-white"
				>
					Habis
				</span>
			</div>
			<p data-slot="harga" class="mt-4 text-3xl font-bold text-primary">
				<span data-slot="harga-angka"></span>
				<span data-slot="harga-satuan" class="ml-1 text-base font-medium text-ink-muted"></span>
			</p>
			<p data-slot="harga-kosong" class="mt-4 text-lg font-medium text-ink-muted">Hubungi admin untuk harga</p>
			<p data-slot="ringkasan" class="mt-4 text-base font-medium leading-7 text-ink"></p>
			<div data-slot="deskripsi" class="mt-4 whitespace-pre-line rounded-xl border border-line bg-surface p-4 text-base leading-7 text-ink-muted"></div>
			<dl data-slot="rincian" class="mt-5 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-base">
				<div data-slot="rincian-minimal" class="contents">
					<dt class="font-semibold text-ink">Minimal pesan</dt>
					<dd data-slot="nilai" class="text-ink-muted"></dd>
				</div>
				<div data-slot="rincian-satuan" class="contents">
					<dt class="font-semibold text-ink">Satuan</dt>
					<dd data-slot="nilai" class="text-ink-muted"></dd>
				</div>
				<div data-slot="rincian-produsen" class="contents">
					<dt class="font-semibold text-ink">Produsen</dt>
					<dd data-slot="nilai" class="text-ink-muted"></dd>
				</div>
			</dl>
			<a
				data-slot="wa"
				href="#"
				class="mt-6 inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-xl bg-primary px-5 py-3 font-semibold text-white transition-colors hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:w-auto"
			>
				<Icon name="whatsapp" class="size-5" />
				<span data-slot="wa-label"></span>
			</a>
		</div>
	</div>
</template>
