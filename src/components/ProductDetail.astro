---
// Detail satu produk untuk popup. Konten diambil dari data produk saat build.
import Icon from './Icon.astro';
import { getContactLink, siteConfig } from '../config/site.js';

const { produk } = Astro.props;
const foto = produk.foto[0];
const adaWa = Boolean(siteConfig.whatsapp);
const adaRincian = produk.satuan || produk.minimalPesan || produk.produsen;
---

<div data-detail-root class="grid gap-6 p-4 sm:p-6 md:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] md:gap-8">
	<div>
		{foto ? (
			<>
				<button
					type="button"
					data-lightbox-buka
					data-besar={foto.besar}
					data-alt={foto.alt}
					data-nama={produk.nama}
					aria-label="Perbesar foto"
					class="group relative block w-full overflow-hidden rounded-lg border border-line focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
				>
					<img data-detail-gambar src={foto.besar} alt={foto.alt} class="aspect-[4/3] w-full object-cover" decoding="async" />
					<span class="absolute bottom-2 right-2 flex size-8 items-center justify-center rounded-full bg-white text-primary">
						<Icon name="zoom-in" class="size-4" />
					</span>
				</button>
				{produk.foto.length > 1 && (
					<ul class="mt-3 flex flex-wrap gap-2">
						{produk.foto.map((f, i) => (
							<li>
								<button
									type="button"
									data-thumb
									data-besar={f.besar}
									data-alt={f.alt}
									aria-label={`Tampilkan foto ${i + 1}`}
									aria-current={i === 0 ? 'true' : undefined}
									class="block overflow-hidden rounded-md border border-line focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary aria-[current=true]:border-primary"
								>
									<img src={f.mini} alt="" width="64" height="64" class="size-16 object-cover" decoding="async" />
								</button>
							</li>
						))}
					</ul>
				)}
			</>
		) : (
			<div
				role="img"
				aria-label={`Placeholder foto ${produk.nama}`}
				class="flex aspect-[4/3] items-center justify-center rounded-lg border border-line bg-surface px-4 text-center text-base font-medium text-ink-muted"
			>
				[ISI NANTI: foto produk]
			</div>
		)}
	</div>
	<div class="min-w-0">
		<p class="text-sm font-semibold uppercase tracking-wide text-primary">{produk.kategori}</p>
		<h2 id="produk-dialog-judul" class="mt-2 break-words text-2xl font-bold text-ink sm:text-3xl">{produk.nama}</h2>
		<div class="ornament" aria-hidden="true"></div>
		<div class="mt-4 flex flex-wrap gap-2">
			{produk.unggulan && (
				<span class="inline-flex min-h-7 items-center rounded-full border border-gold bg-gold-soft px-3 text-xs font-semibold text-ink">
					Unggulan
				</span>
			)}
			{produk.status === 'tersedia' && (
				<span class="inline-flex min-h-7 items-center rounded-full border border-line bg-surface px-3 text-xs font-semibold text-ink">
					{produk.statusInfo.label}
				</span>
			)}
			{produk.status === 'pre-order' && (
				<span class="inline-flex min-h-7 items-center rounded-full border border-line bg-white px-3 text-xs font-semibold text-ink">
					{produk.statusInfo.label}
				</span>
			)}
			{produk.status === 'habis' && (
				<span class="inline-flex min-h-7 items-center rounded-full border border-ink bg-ink px-3 text-xs font-semibold text-white">
					{produk.statusInfo.label}
				</span>
			)}
		</div>
		{produk.hargaTampil ? (
			<p class="mt-4 text-3xl font-bold text-primary">
				{produk.hargaTampil}
				{produk.satuan && <span class="ml-1 text-base font-medium text-ink-muted">/ {produk.satuan}</span>}
			</p>
		) : (
			<p class="mt-4 text-lg font-medium text-ink-muted">Hubungi admin untuk harga</p>
		)}
		{produk.ringkasan && <p class="mt-4 text-base font-medium leading-7 text-ink">{produk.ringkasan}</p>}
		{produk.deskripsi && (
			<div class="mt-4 whitespace-pre-line rounded-xl border border-line bg-surface p-4 text-base leading-7 text-ink-muted">
				{produk.deskripsi}
			</div>
		)}
		{adaRincian && (
			<dl class="mt-5 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-base">
				{produk.satuan && (
					<>
						<dt class="font-semibold text-ink">Satuan</dt>
						<dd class="text-ink-muted">{produk.satuan}</dd>
					</>
				)}
				{produk.minimalPesan && (
					<>
						<dt class="font-semibold text-ink">Minimal pesan</dt>
						<dd class="text-ink-muted">{produk.minimalPesan}</dd>
					</>
				)}
				{produk.produsen && (
					<>
						<dt class="font-semibold text-ink">Produsen</dt>
						<dd class="text-ink-muted">{produk.produsen}</dd>
					</>
				)}
			</dl>
		)}
		<a
			href={getContactLink(produk.pesanWa)}
			target={adaWa ? '_blank' : undefined}
			rel={adaWa ? 'noopener noreferrer' : undefined}
			class="mt-6 inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-xl bg-primary px-5 py-3 font-semibold text-white transition-colors hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:w-auto"
		>
			<Icon name="whatsapp" class="size-5" />
			{produk.statusInfo.tombol}
		</a>
	</div>
</div>
