---
// Bagian komunitas sponsor di Beranda: pengantar, Visi, Misi, dan slogan. Semua teks dari siteConfig.sponsor (src/config/site.js).
import { siteConfig } from '../config/site.js';
const { sponsor } = siteConfig;
---

<section id="komunitas" aria-labelledby="komunitas-title" class="bg-white">
	<div class="site-container py-20 sm:py-24">
		<div class="max-w-3xl">
			<p class="text-sm font-semibold uppercase tracking-wide text-primary">{sponsor.label}</p>
			<h2 id="komunitas-title" class="mt-2 text-3xl font-bold text-ink sm:text-4xl">{sponsor.nama}</h2>
			<div class="ornament" aria-hidden="true"></div>
			<p class="mt-5 text-base leading-7 text-ink-muted sm:text-lg sm:leading-8">{sponsor.pengantar}</p>
			<p class="mt-3 text-base font-semibold leading-7 text-ink">{sponsor.catatan}</p>
		</div>

		<div class="mt-12 grid gap-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-stretch lg:gap-x-16 xl:gap-x-24 2xl:gap-x-40">
			<div class="batik-panel batik-panel-dark batik-panel-card flex flex-col justify-center px-6 py-10 sm:px-10 sm:py-12">
				<h3 class="text-center text-2xl font-bold text-white">Visi</h3>
				<div class="ornament ornament-center" aria-hidden="true"></div>
				<p class="mt-6 font-serif text-xl leading-9 text-white sm:text-2xl sm:leading-10">
					{sponsor.visi.awal} <strong class="font-bold text-gold">{sponsor.visi.kunci}</strong> {sponsor.visi.akhir}
				</p>
			</div>

			<!-- Kartu bergaya kertas (sama seperti bagian Tentang desa): lembar belakang miring + bingkai dalam emas tipis -->
			<div class="relative isolate w-full before:pointer-events-none before:absolute before:inset-0 before:-z-10 before:rotate-2 before:rounded-xl before:border before:border-line before:bg-gold-soft before:content-['']">
				<article class="relative rounded-xl border border-line bg-white p-6 sm:p-10 after:pointer-events-none after:absolute after:inset-3 after:rounded-lg after:border after:border-gold after:content-['']">
					<h3 class="text-center text-2xl font-bold text-ink">Misi</h3>
					<div class="ornament ornament-center" aria-hidden="true"></div>
					<ol class="mt-6">
						{sponsor.misi.map((teks, i) => (
							<li class={i === 0 ? 'flex gap-4' : 'mt-5 flex gap-4 border-t border-line pt-5'}>
								<span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-primary text-base font-semibold text-white" aria-hidden="true">{i + 1}</span>
								<p class="min-w-0 text-base leading-7 text-ink-muted">{teks}</p>
							</li>
						))}
					</ol>
				</article>
			</div>
		</div>

		<div class="mt-12 text-center">
			<div class="ornament ornament-center" aria-hidden="true"></div>
			<p class="mt-4 font-serif text-xl font-bold text-primary sm:text-2xl">
				{sponsor.slogan.map((kata, i) => (
					<Fragment>
						{i > 0 && <span class="mx-2 text-gold" aria-hidden="true">•</span>}
						{kata}
					</Fragment>
				))}
			</p>
		</div>
	</div>
</section>
